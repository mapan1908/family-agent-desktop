# ====================================================================
# 家庭 Agent 配置文件模板
# ====================================================================
# 拷贝本文件到对应位置并填好 LLM key：
#   开发模式:   cp .env.example .env
#   桌面端:     ~/Library/Application Support/family-agent/config/.env
#               (macOS) 或 %APPDATA%\family-agent\config\.env (Windows)
#   NAS Docker: 容器内 /config/.env（已 mount 进卷）
#
# 加载顺序：项目根 .env → 平台默认路径 .env（后者覆盖前者）
# ====================================================================


# ===== LLM（必填）=====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus


# ===== Web 面板端口（可选，默认 3099）=====
FAMILY_PORT=3099


# ===== 路径（一般不用填，平台自动选）=====
# 配置目录（放 .env 和未来配置）
# FAMILY_CONFIG_DIR=
# 数据目录（放 db、files、notes）
# FAMILY_DATA_DIR=
# SQLite db 路径（默认 <FAMILY_DATA_DIR>/agent.db）
# DB_PATH=
#
# 兼容旧 .env 的 DATA_DIR（仍在用）
# DATA_DIR=./data


# ===== 启动扫描路径（必填，按部署形态）=====
# 多个路径用英文逗号分隔，agent 启动时会把路径下所有文件建索引
#
# 开发模式:        ./data/files,./data/notes （默认值，可省略）
# NAS + Docker:    /data/files,/data/notes   （对应 docker-compose mount 点）
# macOS / Linux 桌面: ~/Documents/FamilyAgent
# Windows 桌面:    C:\Users\<用户名>\Documents\FamilyAgent
#
# SCAN_PATHS=./data/files,./data/notes


# ===== 媒体处理（可选）=====
# voice: reject (默认) | transcribe | passthrough
# image: off (默认，只落盘) | vision (喂给多模态模型)
VOICE_SUPPORT=reject
IMAGE_AI=off


# ===== 家长 PIN（已弃用，留空即可）=====
PARENT_PIN=
